# Supabase project API credentials — Project Settings > API in the Supabase dashboard.
# The anon key is safe to ship in frontend bundles (it's what RLS policies gate).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# InstantMesh reconstruction API.
# - Local dev: ZeroTier address of the GPU workstation (http://localhost:43839 if
#   running on the GPU host itself). Requests go through the Vite dev proxy either way.
# - Production/deployed builds: the public URL of the Cloudflare Tunnel in front of
#   `instantmesh-proxy/` (NOT InstantMesh's raw port — that's only reachable over
#   ZeroTier and has no auth of its own). e.g. https://instantmesh.yourdomain.com
VITE_INSTANTMESH_URL=http://10.231.121.101:43839
