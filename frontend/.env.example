# Supabase project API credentials — Project Settings > API in the Supabase dashboard.
# The anon key is safe to ship in frontend bundles (it's what RLS policies gate).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# instantmesh-proxy/ — fronts BOTH GPU model APIs (InstantMesh reconstruction and
# Fooocus-API co-creation), fixing InstantMesh's CORS bug, requiring a valid Supabase
# login, and serializing the two models so they never run at once on the shared GPU.
# instantMesh.js calls `${this}/api/...`, fooocus.js calls `${this}/fooocus/...`.
# - Local dev: ZeroTier address of the GPU workstation running the proxy
#   (http://localhost:8787 if running on the GPU host itself).
# - Production/deployed builds: the public URL of the Cloudflare Tunnel in front of the
#   proxy (NOT either model's raw port — those are only reachable over ZeroTier and have
#   no auth of their own). This project's actual tunnel: https://instantmesh.zpsyche.com
#   — confirmed 2026-08-08 to reach the real instantmesh-proxy (not InstantMesh raw): both
#   /api/health and /fooocus/... return 401 (proxy's global auth gate; InstantMesh raw has
#   no auth and no /fooocus route at all), and its CORS preflight for the deployed Vercel
#   origin already succeeds. Set VITE_GPU_PROXY_URL to this in Vercel's project env vars
#   (Settings > Environment Variables) — this file/local .env do not deploy there.
VITE_GPU_PROXY_URL=http://10.231.121.101:8787
