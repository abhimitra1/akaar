# Port this proxy listens on. The Cloudflare Tunnel (or ngrok) points at this port.
PORT=8787

# Where the real InstantMesh API is listening (same box, so localhost).
INSTANTMESH_TARGET=http://127.0.0.1:43839

# Comma-separated list of origins allowed to call this proxy. Must match exactly
# (scheme + host, no trailing slash) — include both your deployed Vercel URL and
# localhost:5173 for local dev against the real GPU box.
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# Supabase project's JWT secret (Project Settings > API > JWT Settings in the
# Supabase dashboard). Used to verify that requests come from a logged-in user of
# the app — NOT the anon/service key.
SUPABASE_JWT_SECRET=/x5LwTCXgj/6TCiMw9v+6mZ1QeIxEL7HQs7Bt9MscYxvwg/i189lMouW8KScknvbdgIxO/NbrDy93ECCm/FLZA==

# Max job submissions (POST /api/generate) allowed per signed-in user per hour.
RATE_LIMIT_PER_HOUR=20
