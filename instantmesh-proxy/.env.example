# Port this proxy listens on. The Cloudflare Tunnel (or ngrok) points at this port.
PORT=8787

# Where the real InstantMesh API is listening (same box, so localhost) — UNLESS InstantMesh
# runs inside WSL2 on that box and 127.0.0.1->WSL localhost-forwarding is unreliable there
# (seen on this project's actual GPU box); if so, use that box's own LAN/ZeroTier address
# instead (routes through a netsh portproxy rule pointed at the WSL VM's IP) rather than
# 127.0.0.1. Symptom to watch for: this proxy's logs show ECONNREFUSED to 127.0.0.1 even
# though InstantMesh answers fine when hit directly.
INSTANTMESH_TARGET=http://127.0.0.1:43839

# Where the real Fooocus-API is listening (same box, so localhost).
FOOOCUS_TARGET=http://127.0.0.1:8888

# Comma-separated list of origins allowed to call this proxy. Must match exactly
# (scheme + host, no trailing slash) — include your deployed Vercel URL, localhost:5173 for
# dev on this box itself, AND this box's own LAN/ZeroTier IP:5173 if you ever test from
# another device (e.g. a phone) pointed at that IP — that's a different origin string from
# localhost even though it's the same Vite dev server, so it needs its own explicit entry.
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173,http://YOUR-LAN-OR-ZEROTIER-IP:5173

# Same value as the frontend's VITE_SUPABASE_URL. Used to fetch Supabase's public
# JWKS (https://<this>/auth/v1/.well-known/jwks.json) to verify login tokens — this
# project signs tokens with an asymmetric key (ES256), not a shared secret, so there
# is no secret to store here.
SUPABASE_URL=https://your-project-ref.supabase.co

# Where the local, no-cost content moderation service (../moderation-service) is listening
# (same box, so localhost). Screens every submission (InstantMesh's source photo; Fooocus's
# prompt + source photo) before it's queued or forwarded to either model — see the AI Usage
# Policy at frontend's /policy route for what this enforces, and moderation-service/main.py
# for how (CLIP + Detoxify, both open-source, no external API, no per-request cost). Must be
# running before this proxy will accept any submission — see moderation-service's own README.
MODERATION_SERVICE_URL=http://127.0.0.1:8790

# Max job submissions allowed per signed-in user per hour, combined across both
# InstantMesh (POST /api/generate) and Fooocus (POST /fooocus/v2/generation/image-prompt)
# — they draw on the same GPU time budget.
RATE_LIMIT_PER_HOUR=20

# Both models share one GPU and this proxy serializes them (see server.js's GPU queue) —
# if a submitted job never reports a terminal status within this long, the queue
# force-releases so one stuck job can't wedge every future submission forever.
GPU_JOB_MAX_WAIT_MS=600000
